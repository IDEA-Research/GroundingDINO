# .env.qe — environment for nicu_qe (medical-query-engine.service)
# Location on orin11: /home/cluster/services/query_engine/.env.qe  (mode 600, owner cluster)
# Read by systemd (EnvironmentFile=) and can be sourced by bash:  set -a; . ./.env.qe; set +a
# Format rules: KEY=value, no quotes, no spaces around '=', no inline comments.
# Reference: API_CONTRACT.md §0 and §6, DESIGN.md §12.

# ---- MongoDB ----------------------------------------------------------------
# Source Mongo (docker container medical-mongodb, host network, no auth).
QE_SOURCE_URI=mongodb://127.0.0.1:27017
# Source DB: READ-ONLY for this service (live medical data).
QE_SOURCE_DB=medical_monitor_db
# Derived DB owned by this service. MUST match ^medical_monitor_qe(_test)?$ and
# MUST NOT equal QE_SOURCE_DB; the service refuses to start otherwise.
# NEVER set this to medical_monitor_db.
QE_DB=medical_monitor_qe
# Per-operation Mongo maxTimeMS.
QE_MONGO_MAX_TIME_MS=10000

# ---- HTTP -------------------------------------------------------------------
# host:port. Keep loopback. Port 8020 was free on 2026-09-28.
QE_BIND=127.0.0.1:8020
# Required token for /v1/* (header X-QE-Token). /health is exempt.
# Left empty here on purpose: install.sh fills it with `openssl rand -hex 32`
# the first time it creates .env.qe. Consumers read it as
# HELPER_DASHBOARD_QUERY_ENGINE_TOKEN.
QE_API_TOKEN=
# Set to 1 ONLY for local testing without a token (allowed only with a loopback
# QE_BIND). Leave commented out in production.
# QE_ALLOW_NO_TOKEN=1

# ---- Time zones -------------------------------------------------------------
# Source DB stores Taipei wall-clock time labelled as UTC; this is the zone used
# to reinterpret it into true UTC (not a hard-coded +8).
QE_SOURCE_TZ=Asia/Taipei
# Zone for HTTP responses and for date-only / naive query parameters.
QE_DISPLAY_TZ=Asia/Taipei
# Zone of date-times embedded in uploaded video file names (default = QE_SOURCE_TZ).
QE_FILENAME_TZ=Asia/Taipei
# Stream captures before this date get time_basis=capture_legacy (confidence medium).
QE_STREAM_RELIABLE_FROM=2026-06-01
# Comma-separated file-name markers meaning the video was edited/cut
# (time_confidence=low, flag edited_video).
QE_EDITED_MARKERS=redacted,遮蔽,移除,edited,cut

# ---- ETL --------------------------------------------------------------------
# Incremental sync interval (seconds), by screen_analysis._id watermark.
QE_ETL_INTERVAL_S=60
# Re-scan interval for corrected / quality-marked documents (seconds).
QE_ETL_CORRECTION_RESCAN_S=600
# Full reconcile interval (seconds; 21600 = 6 h).
QE_ETL_RECONCILE_S=21600

# ---- Query limits -----------------------------------------------------------
# Max from..to span in days.
QE_MAX_RANGE_DAYS=400
# Max points per response (above this: truncated=true + suggested_step).
QE_MAX_POINTS=10000
# Above this many values, stats percentiles are null with a note; series median -> 400.
QE_MAX_STATS_VALUES=200000
