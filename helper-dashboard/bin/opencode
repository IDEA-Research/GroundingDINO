def _build_extend_system_prompt(agent: str, widget_type: str, extend: dict) -> str:
    """System prompt for rescue_extend. Combines the standard agent
    body with a Mode C extension that names the widget_type, lists the
    allowed file paths verbatim, and describes the 5-layer change."""
    agent_md = _AGENTS_DIR / f"{agent}.md"
    if not agent_md.exists():
        raise _ProviderError(f"missing agent file: {agent_md}")
    body = agent_md.read_text(encoding="utf-8")
    camel = _camel_case_widget_type(widget_type)
    allowed = [str(p.relative_to(_ROOT.resolve()))
                for p in _extend_write_allowlist(widget_type)]
    mode_c = (
        f"\n\n## Operation: rescue_extend (Mode C)\n\n"
        f"You are extending the widget toolkit with a new type "
        f"`{widget_type}`. The user-facing dashboard pipeline failed "
        f"because this type does not yet exist. You have tool access: "
        f"`read_file`, `write_file`, `replace_in_file`, `run_command`, "
        f"`done`.\n\n"
        f"### Required 5-layer change\n\n"
        f"1. Add `{widget_type} = \"{widget_type}\"` to the WidgetType "
        f"enum in `backend/app/specs/widget_spec.py`.\n"
        f"2. Document the type in `backend/app/specs/widget_schema_doc.py` "
        f"(add to allowed-options table if widget-specific options apply).\n"
        f"3. Add `\"{widget_type}\"` to the WidgetType literal in "
        f"`frontend/lib/spec-schema.ts`.\n"
        f"4. Create `frontend/widget-toolkit/{camel}Widget.tsx` exporting "
        f"a React component. Use a small functional component; keep it "
        f"under 200 lines. Mirror the structure of the existing "
        f"LineChartWidget / TableWidget files.\n"
        f"5. Add a case for the new type in the renderer switch in "
        f"`frontend/lib/renderer.tsx`.\n\n"
        f"### Required tests\n\n"
        f"After editing, run:\n"
        f"  run_command(cmd='pytest', args=['tests/spec_validation/', '-x', '--tb=short'])\n"
        f"All tests must pass before you call `done`.\n\n"
        f"### Path allow-list (writes only)\n\n"
        f"You may only write/replace these exact paths:\n"
        + "".join(f"  - `{p}`\n" for p in allowed)
        + f"\nReads under backend/, frontend/, .opencode/, tests/, docs/ "
        f"are allowed.\n\n"
        f"### Final output\n\n"
        f"When done (and only when pytest is green), call `done(report={{"
        f"\"type\":\"DeveloperReport\",\"report_id\":\"<slug>\","
        f"\"summary\":\"<what you did>\",\"actions_taken\":[...],"
        f"\"tests_run\":[...],\"status\":\"resolved\"}})`.\n"
    )
    return body + mode_c


def _build_autofix_system_prompt(agent: str, args: dict) -> str:
    """System prompt for developer_fix in AUTO-FIX mode: Big guy
    consumes a diagnostic ticket with tool access, bounded by the
    auto-fix write allow-list. No human is in the loop."""
    agent_md = _AGENTS_DIR / f"{agent}.md"
    if not agent_md.exists():
        raise _ProviderError(f"missing agent file: {agent_md}")
    body = agent_md.read_text(encoding="utf-8")
    ticket = args.get("ticket") or {}
    try:
        ticket_json = json.dumps(ticket, indent=2)[:4000]
    except Exception:
        ticket_json = str(ticket)[:4000]
    mode_auto = (
        "\n\n## Operation: developer_fix (AUTO-FIX mode)\n\n"
        "The automated review pipeline filed the diagnostic ticket "
        "below. No human is in the loop: make the smallest correct "
        "code change that fixes the ROOT CAUSE, run the relevant "
        "tests, and report honestly. You have tool access: "
        "`read_file`, `write_file`, `replace_in_file`, `run_command`, "
        "`done`.\n\n"
        "### Ticket\n\n"
        "```json\n" + ticket_json + "\n```\n\n"
        "### Path allow-list (writes only)\n\n"
        "Exact files:\n"
        + "".join(f"  - `{p}`\n" for p in _AUTOFIX_WRITE_FILES)
        + "Any file under:\n"
        + "".join(f"  - `{p}`\n" for p in _AUTOFIX_WRITE_DIR_PREFIXES)
        + "\nClinical anomaly-detection files (backend/app/services/"
        "anomaly_*, prometheus/, alert_rule_spec.py, api/anomaly.py) "
        "are NEVER writable. The backend byte-verifies them after "
        "your run and reverts EVERYTHING you did if any changed — "
        "including via run_command side effects. Do not touch them.\n"
        "Reads under backend/, frontend/, .opencode/, tests/, docs/ "
        "are allowed.\n\n"
        "### Required validation\n\n"
        "After editing, run the pytest suite(s) covering the files "
        "you changed, e.g.:\n"
        "  run_command(cmd='pytest', args=['tests/review_loop/', '--tb=short'])\n"
        "Never list a test in tests_run that you did not actually "
        "run in this session.\n\n"
        "### Honesty rules\n\n"
        "- status='resolved' ONLY if you made a real change AND the "
        "tests you ran passed.\n"
        "- If the fix is outside your allowed paths, or you cannot "
        "reproduce/fix it, call done with status='rejected' and a "
        "clear summary — the diagnostic then remains for the dev-time "
        "agents. A rejected-but-honest report is always better than "
        "a fabricated resolution.\n\n"
        "### Final output\n\n"
        "Exactly one call: done(report={\"type\":\"DeveloperReport\","
        "\"report_id\":\"<slug>\",\"ticket_id\":\"<ticket_id>\","
        "\"summary\":\"<what you did>\",\"actions_taken\":[...],"
        "\"tests_run\":[...],\"status\":\"resolved|rejected\"}).\n"
    )
    return body + mode_auto


def _normalize_developer_report(raw: dict, *, default_status: str = "resolved") -> dict:
    """Ensure the report dict has type='DeveloperReport' and at least
    the required keys. Missing keys get safe defaults so the runtime
    contract check doesn't reject a near-miss. `default_status` is
    "resolved" for rescue_extend (historical behavior) but MUST be
    "rejected" for auto-fix runs — a report that never stated a status
    cannot count as a successful autonomous fix."""
    if not isinstance(raw, dict):
        raw = {}
    r = dict(raw)
    r["type"] = "DeveloperReport"
    r.setdefault("report_id", f"rep-{uuid.uuid4().hex[:8]}")
    r.setdefault("summary", "tool-mode run completed")
    r.setdefault("actions_taken", [])
    r.setdefault("tests_run", [])
    r.setdefault("status", default_status)
    return r


def _openrouter_run_with_tools(operation: str, agent: str, args: dict) -> dict:
    """Function-calling loop for rescue_extend. Each iteration POSTs to
    OpenRouter with the running message history + the tools schema,
    executes any tool calls in the response (proxied through the
    allow-lists above), appends results to history, and repeats. The
    loop exits when the LLM calls `done` or hits _TOOL_LOOP_MAX_ITERS.
    """
    api_key = os.getenv("OPENROUTER_API_KEY", "").strip()
    if not api_key:
        raise _ProviderError("OPENROUTER_API_KEY is not set")
    widget_type = ""
    if operation == "rescue_extend":
        extend = args.get("extend") or {}
        widget_type = (extend.get("widget_type") or "").strip()
        if not widget_type:
            raise _ProviderError("rescue_extend missing extend.widget_type")
        # Belt-and-braces — Pydantic already validated this regex
        # backend-side, but bin/opencode is a separate process and
        # shouldn't trust args blindly.
        if not re.fullmatch(r"[a-z][a-z0-9_]{2,31}", widget_type):
            raise _ProviderError(
                f"invalid widget_type for rescue_extend: {widget_type!r}"
            )
        system_prompt = _build_extend_system_prompt(agent, widget_type, extend)
    elif operation == "developer_fix":
        system_prompt = _build_autofix_system_prompt(agent, args)
    else:  # pragma: no cover - TOOL_USE_OPERATIONS gates this
        raise _ProviderError(f"no tool-mode prompt for operation {operation!r}")

    model = _pick_model(operation)
    user_prompt = _build_user_prompt(operation, args)
    messages: list[dict] = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": user_prompt},
    ]

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
        "HTTP-Referer": "https://helper-dashboard.local/",
        "X-Title": f"Helper Dashboard ({operation})",
    }
    timeout = float(os.getenv("OPENCODE_HTTP_TIMEOUT", "120"))

    _dbg(
        f"tool_loop:start operation={operation!r} "
        f"widget_type={widget_type!r} model={model!r}"
    )

    for iter_n in range(1, _TOOL_LOOP_MAX_ITERS + 1):
        body = {
            "model": model,
            "messages": messages,
            "tools": _RESCUE_EXTEND_TOOLS,
            "tool_choice": "auto",
            "temperature": 0.2,
        }
        req = urllib.request.Request(
            _OPENROUTER_URL,
            data=json.dumps(body).encode("utf-8"),
            headers=headers,
            method="POST",
        )
        try:
            ctx = ssl.create_default_context()
            with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
                raw = resp.read().decode("utf-8")
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")[:400]
            raise _ProviderError(
                f"openrouter HTTP {exc.code} in tool loop iter {iter_n}: {detail}"
            ) from exc
        except urllib.error.URLError as exc:
            raise _ProviderError(
                f"openrouter network in tool loop iter {iter_n}: {exc}"
            ) from exc

        try:
            data = json.loads(raw)
            msg = data["choices"][0]["message"]
        except Exception as exc:
            raise _ProviderError(f"openrouter response parse: {exc}") from exc

        # Echo the assistant message into history so the model can see
        # its own prior tool calls on the next iteration.
        messages.append({
            "role": "assistant",
            "content": msg.get("content"),
            "tool_calls": msg.get("tool_calls"),
        })

        tool_calls = msg.get("tool_calls") or []
        if not tool_calls:
            # No tool call — try to extract a DeveloperReport from the
            # content. This is the "LLM forgot to call done" fallback.
            parsed = _extract_first_json_object(msg.get("content") or "")
            if parsed is not None and parsed.get("type") == "DeveloperReport":
                _dbg(f"tool_loop:end iter={iter_n} via content fallback")
                return _normalize_developer_report(
                    parsed,
                    default_status=(
                        "resolved" if operation == "rescue_extend" else "rejected"
                    ),
                )
            raise _ProviderError(
                f"tool loop iter {iter_n}: no tool_calls and no DeveloperReport "
                f"in content; aborting"
            )

        for tc in tool_calls:
            try:
                name = tc["function"]["name"]
                raw_args = tc["function"]["arguments"]
                tc_args = json.loads(raw_args) if isinstance(raw_args, str) else (raw_args or {})
            except Exception as exc:
                _dbg(f"tool_loop:bad tool_call: {exc}")
                name, tc_args = "", {}

            if name == "done":
                report = tc_args.get("report") if isinstance(tc_args, dict) else {}
                _dbg(f"tool_loop:end iter={iter_n} via done()")
                return _normalize_developer_report(
                    report or {},
                    default_status=(
                        "resolved" if operation == "rescue_extend" else "rejected"
                    ),
                )

            try:
                if name == "read_file":
                    result_str = _tool_read_file(tc_args)
                elif name == "write_file":
                    result_str = _tool_write_file(tc_args, operation, widget_type)
                elif name == "replace_in_file":
                    result_str = _tool_replace_in_file(tc_args, operation, widget_type)
                elif name == "run_command":
                    result_str = _tool_run_command(tc_args)
                else:
                    raise _ToolError(f"unknown tool: {name!r}")
                # Tag the result so the LLM can grep for it in long histories.
                preview = result_str if len(result_str) < 80 else result_str[:77] + "..."
                _dbg(f"tool_loop:iter={iter_n} tool={name!r} ok={preview!r}")
            except _ToolError as exc:
                # Feed the error back to the LLM as the tool result.
                result_str = json.dumps({"error": str(exc)})
                _dbg(f"tool_loop:iter={iter_n} tool={name!r} err={exc}")

            messages.append({
                "role": "tool",
                "tool_call_id": tc.get("id", ""),
                "content": result_str,
            })

    raise _ProviderError(
        f"{operation} tool loop exceeded {_TOOL_LOOP_MAX_ITERS} iterations "
        f"without calling done()"
    )


if __name__ == "__main__":
    sys.exit(main())
