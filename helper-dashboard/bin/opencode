# ---------------------------------------------------------------------------
# __TOOL_USE__  (M3: rescue_extend tool-using mode)
# ---------------------------------------------------------------------------
#
# Big guy, when invoked for the `rescue_extend` operation, gets access
# to a small set of allow-listed Python tools (`read_file`,
# `write_file`, `replace_in_file`, `run_command`, `done`). The runtime
# proxies each tool call through hard-coded path / shell allow-lists,
# so a compromised LLM cannot escape the sandbox by asking nicely.
#
# Defense in depth — three layers must all permit the action:
#
#   1. The OpenRouter tool-schema only declares these 5 tools.
#   2. The dispatcher in `_openrouter_run_with_tools` only knows how
#      to route those 5 names — any other name returns a ToolError to
#      the LLM (which the LLM may or may not understand).
#   3. Each tool handler revalidates path / command against its own
#      allow-list before touching the filesystem or subprocess.
#
# M5 adds an env-flag gate on the *backend* side so the user-facing
# chat flow never reaches this code unless an operator opts in.
#
# Allow-listed shells for rescue_extend. shell=False always; this is
# the argv[0] only.
_SHELL_ALLOWLIST: set[str] = {"pytest", "npm", "node", "npx", "python3", "python3.10"}

# Loop bounds — break the LLM out of pathological repetition.
_TOOL_LOOP_MAX_ITERS = 30
_TOOL_FILE_MAX_BYTES = 200_000
_TOOL_RUN_TIMEOUT_S = 120

# Files the LLM may always *read* under rescue_extend (read access
# is broader than write — Big guy needs to understand the codebase
# before changing it). We still pin to the helper-dashboard tree.
_EXTEND_READ_ROOTS: tuple[str, ...] = (
    "backend/",
    "frontend/",
    ".opencode/",
    "tests/",
    "docs/",
)


class _ToolError(Exception):
    """A tool refused to run. The error string is fed back to the LLM
    as the tool result so it can decide to retry or give up gracefully.

    DO NOT raise _ProviderError from inside a tool handler — that aborts
    the whole subprocess, which loses the LLM's chain of thought."""


def _validate_safe_relative_path(raw: str) -> Path:
    """Resolve `raw` as a path relative to _ROOT.

    Rejects:
      - Absolute paths.
      - Path traversal that escapes _ROOT after resolution.
      - Empty strings, non-strings.

    Returns the resolved Path. Does NOT check whether the file exists.
    """
    if not isinstance(raw, str) or not raw.strip():
        raise _ToolError("path must be a non-empty string")
    if raw.startswith("/") or raw.startswith("~"):
        raise _ToolError(f"absolute paths not allowed: {raw!r}")
    # Resolve under _ROOT; reject anything that walks outside.
    candidate = (_ROOT / raw).resolve()
    try:
        candidate.relative_to(_ROOT.resolve())
    except ValueError:
        raise _ToolError(f"path escapes project root: {raw!r}") from None
    return candidate


def _camel_case_widget_type(widget_type: str) -> str:
    """pie_chart -> PieChart  (snake_case -> PascalCase)."""
    return "".join(p[:1].upper() + p[1:] for p in widget_type.split("_") if p)


def _extend_write_allowlist(widget_type: str) -> tuple[Path, ...]:
    """Files the LLM may write/replace for an extend-widget operation.

    Exactly six paths — the 5-layer change + an optional test file.
    The Pydantic ExtendRequest already validated widget_type's shape,
    so the camel-cased name is safe to interpolate into a filename.
    """
    camel = _camel_case_widget_type(widget_type)
    rels = (
        "backend/app/specs/widget_spec.py",
        "backend/app/specs/widget_schema_doc.py",
        "frontend/lib/spec-schema.ts",
        "frontend/lib/renderer.tsx",
        f"frontend/widget-toolkit/{camel}Widget.tsx",
        f"tests/spec_validation/test_extend_{widget_type}.py",
    )
    return tuple((_ROOT / r).resolve() for r in rels)


def _path_allowed_for_read(path: Path) -> bool:
    """Anything under one of `_EXTEND_READ_ROOTS` is readable."""
    try:
        rel = path.relative_to(_ROOT.resolve())
    except ValueError:
        return False
    rel_s = str(rel).replace("\\", "/")
    return any(rel_s.startswith(r) for r in _EXTEND_READ_ROOTS)


def _path_allowed_for_write(path: Path, widget_type: str) -> bool:
    return path in _extend_write_allowlist(widget_type)


# ---------------------------------------------------------------------------
# Auto-fix (developer_fix) write scope — render/product layer only.
# Mirrored INDEPENDENTLY in backend/app/helper/auto_fix.py (two trust
# boundaries, deliberately not a shared import; keep in sync). The
# backend additionally byte-verifies the clinical files after the run
# and rolls everything back on any difference.
# ---------------------------------------------------------------------------

_AUTOFIX_WRITE_FILES: tuple[str, ...] = (
    "backend/app/services/browser_evaluator.py",
    "frontend/lib/renderer.tsx",
    "frontend/lib/spec-schema.ts",
)

_AUTOFIX_WRITE_DIR_PREFIXES: tuple[str, ...] = (
    "frontend/widget-toolkit/",
    "tests/browser_evaluation/",
    "tests/review_loop/",
    "tests/spec_validation/",
)

# Deny always wins — checked before the allow lists. Clinical safety
# code, the gates themselves, the runtime, and this CLI are never
# writable by any autonomous run.
_AUTOFIX_DENY_PREFIXES: tuple[str, ...] = (
    "backend/app/services/anomaly_",
    "backend/app/services/alert_state_store",
    "backend/app/prometheus/",
    "backend/app/specs/alert_rule_spec",
    "backend/app/api/anomaly",
    "backend/app/helper/extend_gate",
    "backend/app/helper/auto_fix",
    "backend/app/helper/runtime",
    "bin/",
    ".opencode/",
    ".env",
)


def _path_allowed_for_autofix_write(path: Path) -> bool:
    try:
        rel = str(path.relative_to(_ROOT.resolve())).replace("\\", "/")
    except ValueError:
        return False
    if any(rel.startswith(d) for d in _AUTOFIX_DENY_PREFIXES):
        return False
    if rel in _AUTOFIX_WRITE_FILES:
        return True
    return any(rel.startswith(d) for d in _AUTOFIX_WRITE_DIR_PREFIXES)


def _check_write_allowed(path: Path, operation: str, widget_type: str) -> None:
    """Raise _ToolError when `path` is outside the write scope for
    this operation. Shared by write_file / replace_in_file."""
    if operation == "developer_fix":
        if not _path_allowed_for_autofix_write(path):
            raise _ToolError(
                f"write refused: {_safe_rel(path)!r} is not in the auto-fix "
                f"allow-list. Allowed files: {list(_AUTOFIX_WRITE_FILES)}; "
                f"allowed dirs: {list(_AUTOFIX_WRITE_DIR_PREFIXES)}. "
                f"Clinical anomaly paths are never writable."
            )
        return
    if not _path_allowed_for_write(path, widget_type):
        allowed = [str(p.relative_to(_ROOT.resolve()))
                    for p in _extend_write_allowlist(widget_type)]
        raise _ToolError(
            f"write refused: {_safe_rel(path)!r} is not in the extend "
            f"allow-list for widget_type={widget_type!r}. Allowed: {allowed}"
        )


def _safe_rel(path: Path) -> str:
    try:
        return str(path.relative_to(_ROOT.resolve()))
    except ValueError:
        return str(path)


# ---------------------------------------------------------------------------
# Tool handlers (M3b + M3c)
# ---------------------------------------------------------------------------


def _tool_read_file(args: dict) -> str:
    path = _validate_safe_relative_path(args.get("path", ""))
    if not _path_allowed_for_read(path):
        raise _ToolError(
            f"read_file refused: path {args.get('path')!r} is not under "
            f"the allowed roots {list(_EXTEND_READ_ROOTS)}"
        )
    if not path.exists():
        raise _ToolError(f"file not found: {args.get('path')!r}")
    if not path.is_file():
        raise _ToolError(f"not a regular file: {args.get('path')!r}")
    try:
        data = path.read_bytes()
    except Exception as exc:
        raise _ToolError(f"read failed: {exc}") from exc
    if len(data) > _TOOL_FILE_MAX_BYTES:
        raise _ToolError(
            f"file too large ({len(data)} bytes > "
            f"{_TOOL_FILE_MAX_BYTES}); refusing to read"
        )
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        raise _ToolError(f"file is not utf-8: {args.get('path')!r}")


def _tool_write_file(args: dict, operation: str, widget_type: str) -> str:
    raw_path = args.get("path", "")
    content = args.get("content", "")
    if not isinstance(content, str):
        raise _ToolError("write_file: content must be a string")
    if len(content.encode("utf-8")) > _TOOL_FILE_MAX_BYTES:
        raise _ToolError(
            f"write_file: content too large; max {_TOOL_FILE_MAX_BYTES} bytes"
        )
    path = _validate_safe_relative_path(raw_path)
    _check_write_allowed(path, operation, widget_type)
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        path.write_text(content, encoding="utf-8")
    except Exception as exc:
        raise _ToolError(f"write failed: {exc}") from exc
    return json.dumps({"ok": True, "path": str(path.relative_to(_ROOT.resolve())),
                        "bytes": len(content.encode("utf-8"))})


def _tool_replace_in_file(args: dict, operation: str, widget_type: str) -> str:
    raw_path = args.get("path", "")
    old = args.get("old_string", "")
    new = args.get("new_string", "")
    if not isinstance(old, str) or not isinstance(new, str):
        raise _ToolError("replace_in_file: old_string and new_string must be strings")
    if old == "":
        raise _ToolError("replace_in_file: old_string cannot be empty")
    path = _validate_safe_relative_path(raw_path)
    _check_write_allowed(path, operation, widget_type)
    if not path.exists():
        raise _ToolError(f"file not found: {raw_path!r}")
    try:
        data = path.read_text(encoding="utf-8")
    except Exception as exc:
        raise _ToolError(f"read for replace failed: {exc}") from exc
    occurrences = data.count(old)
    if occurrences == 0:
        raise _ToolError(
            f"old_string not found in {raw_path!r}; nothing was changed"
        )
    if occurrences > 1:
        raise _ToolError(
            f"old_string appears {occurrences} times in {raw_path!r}; "
            f"provide more surrounding context to make it unique"
        )
    new_data = data.replace(old, new, 1)
    try:
        path.write_text(new_data, encoding="utf-8")
    except Exception as exc:
        raise _ToolError(f"write back failed: {exc}") from exc
    return json.dumps({
        "ok": True,
        "path": str(path.relative_to(_ROOT.resolve())),
        "delta_bytes": len(new_data.encode("utf-8")) - len(data.encode("utf-8")),
    })


def _tool_run_command(args: dict) -> str:
    import subprocess  # local import — only needed for tool use
    cmd = args.get("cmd", "")
    cmd_args = args.get("args", []) or []
    if not isinstance(cmd, str) or not cmd:
        raise _ToolError("run_command: cmd must be a non-empty string")
    if not isinstance(cmd_args, list) or not all(isinstance(a, str) for a in cmd_args):
        raise _ToolError("run_command: args must be a list of strings")
    if cmd not in _SHELL_ALLOWLIST:
        raise _ToolError(
            f"run_command refused: {cmd!r} not in shell allow-list "
            f"{sorted(_SHELL_ALLOWLIST)}"
        )
    # Reject shell metacharacters in args defensively. We pass shell=False
    # so they'd be treated as literal anyway, but a literal "; rm -rf"
    # in argv often signals an LLM trying to escape.
    bad_chars = set(";&|`$><\n")
    for a in cmd_args:
        if any(c in bad_chars for c in a):
            raise _ToolError(
                f"run_command refused: arg {a!r} contains shell "
                f"metacharacter; pass argv elements, not a shell string"
            )
    try:
        proc = subprocess.run(  # noqa: S603 shell=False, allow-listed
            [cmd, *cmd_args],
            capture_output=True,
            text=True,
            timeout=_TOOL_RUN_TIMEOUT_S,
            shell=False,
            cwd=str(_ROOT),
            check=False,
        )
    except FileNotFoundError as exc:
        raise _ToolError(f"command not found: {cmd!r}") from exc
    except subprocess.TimeoutExpired:
        raise _ToolError(f"command timed out after {_TOOL_RUN_TIMEOUT_S}s")
    return json.dumps({
        "returncode": proc.returncode,
        "stdout": (proc.stdout or "")[-4000:],
        "stderr": (proc.stderr or "")[-2000:],
    })


