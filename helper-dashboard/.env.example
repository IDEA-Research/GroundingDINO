# Copy this file to `.env` and fill in values. `.env` is git-ignored.
#
# OpenRouter is used as the LLM provider for the Helper Dashboard
# helpercode CLI (see bin/helpercode). Get a key at https://openrouter.ai.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Model for user-facing Helper agents (fast, cheap, non-reasoning).
HELPERCODE_HELPER_MODEL=anthropic/claude-sonnet-4.6

# Model for the bigger-brain Big guy role (used during rescue review
# and developer_fix).
HELPERCODE_BIG_GUY_MODEL=anthropic/claude-opus-4.6

# Runtime mode: mock | helpercode | auto. Prod: helpercode. Dev: auto.
HELPER_DASHBOARD_HELPERCODE=helpercode

# Optional: append runtime + helpercode debug traces to a single file.
# Works together with HELPER_DASHBOARD_HELPERCODE_TRACE=1 / HELPERCODE_DEBUG=1.
# Example: ./logs/helpercode-trace.log
HELPERCODE_TRACE_FILE=

# Path to the helpercode CLI that ships with this repo.
HELPER_DASHBOARD_HELPERCODE_BIN=./bin/helpercode

# Argv template (JSON array of strings). {bin} and {agent} are
# substituted from the operation allow-list. Value MUST be
# single-quoted so bash preserves the JSON `"` characters.
HELPER_DASHBOARD_HELPERCODE_CMD='["{bin}"]'

# How many seconds to allow per subprocess call. Big guy calls can
# legitimately hit 60-90s when using a thinking model; leave headroom.
HELPER_DASHBOARD_HELPERCODE_TIMEOUT_SECONDS=120

# Enable the synchronous pre-output review loop.
# On for helpercode/auto modes, off by default in mock mode.
HELPER_DASHBOARD_PRE_OUTPUT_REVIEW=1

# Developer-only endpoint gate (/api/developer/*). Pick something long
# and random. Leave empty in development to block all dev endpoints.
HELPER_DASHBOARD_DEV_TOKEN=

# Bounded validation-retry for Helper generate/patch outputs.
# When the LLM's DashboardSpec or PatchSpec fails schema or semantic
# contract checks, the orchestrator retries with structured feedback
# up to this many times. Clamped to [1, 5]; default 3.
HELPER_AGENT_MAX_ATTEMPTS=3

# When 1, each retry loop persists its attempt log under
# backend/app/storage/retry_logs/ (git-ignored). Useful for Tier 1/2
# diagnostics. Secrets are masked before writing.
HELPER_DASHBOARD_PERSIST_RETRY_LOGS=0

# --- DevFix runtime: route developer_fix to the real OpenCode CLI ---
# Which backend handles the developer_fix operation:
#   helpercode   (default) — the hand-rolled bin/helpercode CLI
#   opencode-cli           — the REAL OpenCode CLI (1.18.4) in an isolated
#                            git worktree. PAID LLM calls: flip deliberately.
HELPER_DASHBOARD_DEVFIX_RUNTIME=helpercode

# Absolute path to the real OpenCode CLI binary (nvm dir is not on the
# non-interactive PATH, so spell it out).
HELPER_DASHBOARD_DEVFIX_BIN=/home/cluster/.nvm/versions/node/v20.20.2/bin/opencode

# Model for devfix runs, as provider/model (first /-segment is the provider).
HELPER_DASHBOARD_DEVFIX_MODEL=openrouter/anthropic/claude-opus-4.6

# Hard wall-clock limit per devfix run; the whole process group is
# SIGKILLed on expiry.
HELPER_DASHBOARD_DEVFIX_TIMEOUT_SECONDS=600
