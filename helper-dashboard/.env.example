# Copy this file to `.env` and fill in values. `.env` is git-ignored.
#
# OpenRouter is used as the LLM provider for the Helper Dashboard
# opencode CLI (see bin/opencode). Get a key at https://openrouter.ai.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Model for user-facing Helper agents (fast, cheap, non-reasoning).
OPENCODE_HELPER_MODEL=anthropic/claude-sonnet-4.6

# Model for the bigger-brain Big guy role (used during rescue review
# and developer_fix).
OPENCODE_BIG_GUY_MODEL=anthropic/claude-opus-4.6

# Runtime mode: mock | opencode | auto. Prod: opencode. Dev: auto.
HELPER_DASHBOARD_OPENCODE=opencode

# Optional: append runtime + opencode debug traces to a single file.
# Works together with HELPER_DASHBOARD_OPENCODE_TRACE=1 / OPENCODE_DEBUG=1.
# Example: ./logs/opencode-trace.log
OPENCODE_TRACE_FILE=

# Path to the opencode CLI that ships with this repo.
HELPER_DASHBOARD_OPENCODE_BIN=./bin/opencode

# Argv template (JSON array of strings). {bin} and {agent} are
# substituted from the operation allow-list. Value MUST be
# single-quoted so bash preserves the JSON `"` characters.
HELPER_DASHBOARD_OPENCODE_CMD='["{bin}"]'

# How many seconds to allow per subprocess call. Big guy calls can
# legitimately hit 60-90s when using a thinking model; leave headroom.
HELPER_DASHBOARD_OPENCODE_TIMEOUT_SECONDS=120

# Enable the synchronous pre-output review loop.
# On for opencode/auto modes, off by default in mock mode.
HELPER_DASHBOARD_PRE_OUTPUT_REVIEW=1

# Developer-only endpoint gate (/api/developer/*). Pick something long
# and random. Leave empty in development to block all dev endpoints.
HELPER_DASHBOARD_DEV_TOKEN=

# Bounded validation-retry for Helper generate/patch outputs.
# When the LLM's DashboardSpec or PatchSpec fails schema or semantic
# contract checks, the orchestrator retries with structured feedback
# up to this many times. Clamped to [1, 5]; default 3.
HELPER_AGENT_MAX_ATTEMPTS=3

# When 1, each retry loop persists its attempt log under
# backend/app/storage/retry_logs/ (git-ignored). Useful for Tier 1/2
# diagnostics. Secrets are masked before writing.
HELPER_DASHBOARD_PERSIST_RETRY_LOGS=0
