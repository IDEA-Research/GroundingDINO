{
  "name": "@ui-agent/validator",
  "version": "1.0.0",
  "description": "UI Spec validation and sanitization",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
